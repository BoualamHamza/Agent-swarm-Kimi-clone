/* Agent-Swarm TUI — Kimi-style layout
 *
 * Layout overview:
 *   ┌ Header ──────────────────────────────────────────────┐
 *   │ ChatPane (40%)        │ SwarmComputer (60%)         │
 *   │ ┌ TaskCard ──┐        │ ┌ ComputerHeader ─────────┐ │
 *   │ │            │        │ ├ AgentGrid ──────────────┤ │
 *   │ ├ Thinking ─ ┤        │ │ AgentCards (wrap)       │ │
 *   │ ├ TaskRoster ┤        │ ├ MemoryDrawer ───────────┤ │
 *   │ │ rows…      │        │ └─────────────────────────┘ │
 *   │ └ Answer ────┘        │                             │
 *   ├ InputBar (footer) ─────────────────────────────────-┤
 *   └─────────────────────────────────────────────────────┘
 */

Screen {
    background: $surface;
}

Horizontal#body {
    height: 1fr;
}

/* ─── ChatPane (left) ───────────────────────────────────────────────────── */

ChatPane {
    width: 40%;
    border-right: solid $primary 30%;
    padding: 1;
    height: 1fr;
}

#task-card {
    background: $boost;
    padding: 1 1;
    margin-bottom: 1;
    height: auto;
}

#thinking {
    height: auto;
    margin-bottom: 1;
}

#answer {
    height: auto;
    margin-top: 1;
    padding: 1;
    background: $boost;
}

/* ─── Artifacts tab ─────────────────────────────────────────────────────── */

#computer-tabs {
    height: 1fr;
}

#artifacts-view {
    height: 1fr;
    layout: horizontal;
}

#artifact-list {
    width: 40%;
    height: 1fr;
    border-right: solid $primary 30%;
}

.artifact-list-item {
    height: 1;
    padding: 0 1;
}

#artifact-preview {
    width: 60%;
    height: 1fr;
    padding: 1;
    background: $boost;
}

#artifact-preview-header {
    height: auto;
    margin-bottom: 1;
    color: $text;
}

#artifact-preview-body {
    height: auto;
    color: $text;
}

#artifact-preview-placeholder {
    height: auto;
    color: $text-muted;
}

.-hidden {
    display: none;
}

/* TaskRoster */

#task-roster {
    height: auto;
    border-top: solid $primary 30%;
    padding: 1 0;
}

.roster-title {
    height: 1;
    margin-bottom: 1;
}

.roster-row {
    height: 2;
    margin-bottom: 1;
}

/* ─── SwarmComputer (right) ─────────────────────────────────────────────── */

SwarmComputer {
    width: 60%;
    padding: 0;
    height: 1fr;
}

#computer-header {
    height: 1;
    background: $primary 20%;
    padding: 0 1;
}

#agent-grid {
    layout: grid;
    grid-size: 4;
    grid-columns: 13;
    grid-rows: 8;
    grid-gutter: 1 1;
    padding: 1;
    height: 1fr;
}

#memory-drawer {
    height: auto;
    max-height: 12;
    border-top: solid $primary 30%;
    padding: 1 1;
}

.mem-title {
    height: 1;
    margin-bottom: 1;
}

.mem-row {
    height: 1;
    color: $text;
}

.mem-row.-flash {
    background: $accent 30%;
    color: $text;
}

/* ─── AgentCard ─────────────────────────────────────────────────────────── */

.agent-card {
    width: 13;
    height: 8;
    border: round $primary 50%;
    padding: 0;
    layout: vertical;
}

.agent-card.-working {
    border: heavy $accent;
}

.agent-card > .bubble {
    height: 1;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

.agent-card > .bubble.-hidden {
    color: $boost;
}

.agent-card > #portrait {
    height: 4;
    content-align: center middle;
}

.agent-card > #name {
    height: 1;
    content-align: center middle;
}

.agent-card > #role {
    height: 1;
    content-align: center middle;
}

/* ─── InputBar (footer) ─────────────────────────────────────────────────── */

#input-bar {
    height: 3;
    dock: bottom;
    background: $surface;
}

#task-input {
    width: 100%;
    height: 3;
    border: tall $primary;
}

#task-input:focus {
    border: tall $accent;
}
